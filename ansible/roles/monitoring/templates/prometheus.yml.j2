global:
  scrape_interval: 15s

scrape_configs:

  - job_name: "prometheus"

    static_configs:

      - targets:
          - localhost:9090

  - job_name: "node_exporter"

    static_configs:
{% for host in groups['all'] | sort %}
      - targets:
          - "{{ hostvars[host].ansible_host | default(host) }}:{{ node_exporter_port }}"
        labels:
          instance: "{{ host }}"
{% endfor %}
