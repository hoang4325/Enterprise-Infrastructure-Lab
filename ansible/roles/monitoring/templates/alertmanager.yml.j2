{% set telegram_enabled = (alertmanager_telegram_bot_token | default('') | string | length > 0) and (alertmanager_telegram_chat_id | default('') | string | length > 0) %}
global:
  resolve_timeout: 5m

route:
  receiver: "{{ 'telegram' if telegram_enabled else 'noop' }}"
  group_by:
    - alertname
    - job
    - instance
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

  routes:
    # Cảnh báo critical được gửi ngay sau thời gian gom nhóm ngắn.
    - matchers:
        - severity="critical"
      receiver: "{{ 'telegram' if telegram_enabled else 'noop' }}"
      group_wait: 15s

receivers:
  # Receiver rỗng để Alertmanager vẫn chạy khi chưa nhập kênh thông báo.
  - name: noop
{% if telegram_enabled %}
  - name: telegram
    telegram_configs:
      - bot_token: "{{ alertmanager_telegram_bot_token }}"
        chat_id: {{ alertmanager_telegram_chat_id }}
        # Plain-text format giúp người nhận đọc nhanh mà không phải mở rộng labels.
        message: |-
{% raw %}
          {{ if eq .Status "firing" }}🚨 ALERT FIRING{{ else }}✅ ALERT RESOLVED{{ end }}
          {{ range .Alerts }}
          Alert: {{ .Labels.alertname }}
          Host: {{ .Labels.instance }}
          Severity: {{ .Labels.severity }}
          Summary: {{ .Annotations.summary }}
          Description: {{ .Annotations.description }}
          Source: {{ .GeneratorURL }}
          {{ end }}
{% endraw %}
        send_resolved: true
{% endif %}

inhibit_rules:
  # Khi máy đã DOWN, không gửi thêm các cảnh báo tài nguyên của máy đó.
  - source_matchers:
      - alertname="NodeExporterDown"
    target_matchers:
      - alertname=~"HostHighCPU|HostHighMemory|HostFilesystemAlmostFull"
    equal:
      - instance
