global
    log /dev/log local0
    log /dev/log local1 notice
    user haproxy
    group haproxy
    daemon

    # Chỉ cho phép TLS hiện đại khi HAProxy nhận kết nối HTTPS.
{% if haproxy_tls_enabled %}
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
{% endif %}

defaults
    log global
    mode http

    option httplog
    option dontlognull

    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend http_front
    bind *:80
    mode http
{% if haproxy_tls_enabled %}
    # Ép người dùng chuyển sang kênh mã hóa.
    http-request redirect scheme https code 301
{% endif %}
    # Header bảo vệ cả response redirect từ cổng HTTP.
    http-response set-header X-Content-Type-Options nosniff
    http-response set-header X-Frame-Options DENY
    http-response set-header Referrer-Policy strict-origin-when-cross-origin
    default_backend web_servers

{% if haproxy_tls_enabled %}
frontend https_front
    bind *:443 ssl crt {{ haproxy_tls_pem_file }}
    mode http
    option forwardfor
    http-request set-header X-Forwarded-Proto https
    # Header giúp giảm MIME sniffing, clickjacking và rò rỉ referrer.
    http-response set-header X-Content-Type-Options nosniff
    http-response set-header X-Frame-Options DENY
    http-response set-header Referrer-Policy strict-origin-when-cross-origin
    http-response set-header Permissions-Policy "geolocation=(), camera=(), microphone=()"
    http-response set-header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
    http-response set-header Strict-Transport-Security "max-age=31536000; includeSubDomains"
    default_backend web_servers
{% endif %}

backend web_servers
    mode http
    balance roundrobin

    # Kiểm tra readiness của Spring Boot, MariaDB và Nginx trước khi nhận request.
    option httpchk
    http-check send meth GET uri /readyz ver HTTP/1.1 hdr Host localhost
    http-check expect status 200
{% for web_host in groups['web'] | sort %}
    server {{ web_host }} {{ hostvars[web_host].ansible_host | default(web_host) }}:80 check
{% endfor %}
