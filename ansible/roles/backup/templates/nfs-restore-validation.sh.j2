#!/usr/bin/env bash
# Giải nén backup NFS vào thư mục tạm để kiểm tra archive và checksum.
set -Eeuo pipefail

readonly BACKUP_DIR="{{ backup_storage_directory }}/nfs"
readonly SOURCE_ARCHIVE="$(find "$BACKUP_DIR" -maxdepth 1 -type f -name 'nfs-*.tar.gz' -printf '%T@ %p\n' | sort -nr | head -n1 | cut -d' ' -f2-)"
readonly RESTORE_DIR="{{ backup_restore_directory }}/nfs-$(date -u +%Y%m%dT%H%M%SZ)"

test -n "$SOURCE_ARCHIVE"
test -s "$SOURCE_ARCHIVE"
sha256sum --check "${SOURCE_ARCHIVE}.sha256"
mkdir -p "$RESTORE_DIR"
trap 'rm -rf "$RESTORE_DIR"' EXIT
tar --extract --acls --xattrs --numeric-owner --one-file-system --file "$SOURCE_ARCHIVE" --directory "$RESTORE_DIR"
echo "Restore validation NFS thành công: ${SOURCE_ARCHIVE}"
