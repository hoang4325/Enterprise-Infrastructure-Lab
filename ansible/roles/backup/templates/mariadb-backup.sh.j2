#!/usr/bin/env bash
# Backup MariaDB qua Unix socket để không cần lưu password trong script.
set -Eeuo pipefail

readonly DATABASE="{{ backup_database_name }}"
readonly BACKUP_DIR="{{ backup_database_mount_directory }}/mariadb"
readonly LOG_FILE="{{ backup_database_mount_directory }}/logs/mariadb-backup.log"
readonly RETENTION_DAYS="{{ backup_retention_days }}"
readonly TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
readonly DUMP_FILE="${BACKUP_DIR}/${DATABASE}-${TIMESTAMP}.sql.gz"
readonly TMP_DUMP="${DUMP_FILE}.tmp"

mkdir -p "$BACKUP_DIR" "$(dirname "$LOG_FILE")"
umask 027
exec >> >(tee -a "$LOG_FILE") 2>&1
echo "[$(date -Is)] Bắt đầu backup MariaDB: ${DATABASE}"
trap 'rm -f "$TMP_DUMP"' EXIT

# single-transaction giảm lock với InnoDB; giữ routines, triggers và events.
mariadb-dump --protocol=socket --single-transaction --quick --routines --triggers --events "$DATABASE" | gzip -c > "$TMP_DUMP"
test -s "$TMP_DUMP"
mv "$TMP_DUMP" "$DUMP_FILE"
sha256sum "$DUMP_FILE" > "${DUMP_FILE}.sha256"
find "$BACKUP_DIR" -type f \( -name '*.sql.gz' -o -name '*.sql.gz.sha256' \) -mtime "+${RETENTION_DAYS}" -delete
echo "[$(date -Is)] Backup MariaDB thành công: ${DUMP_FILE}"
