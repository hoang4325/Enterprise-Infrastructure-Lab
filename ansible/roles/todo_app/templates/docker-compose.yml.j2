services:
  todo-app:
{% if todo_app_build_image %}
    # Chế độ local build dùng source đã được Ansible triển khai tại app/.
    build:
      context: ./app
{% endif %}
    image: {{ todo_app_image }}
{% if todo_app_registry_enabled %}
    pull_policy: always
{% endif %}
    env_file:
      - .env
    ports:
      - "127.0.0.1:{{ todo_app_port }}:8080"
    volumes:
      - "{{ todo_app_upload_directory }}:/data/uploads"
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp:size=64m,noexec,nosuid
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
